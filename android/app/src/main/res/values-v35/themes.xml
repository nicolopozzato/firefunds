<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 15 draws apps edge to edge by default: the content would start
         under the status bar and the title bar, hiding the first rows. These
         screens are laid out under the title bar, as before 15. -->
    <style name="AppTheme" parent="@android:style/Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/brand</item>
        <item name="android:colorPrimaryDark">@color/brand</item>
        <item name="android:colorAccent">@color/brand</item>
        <item name="android:windowOptOutEdgeToEdgeEnforcement">true</item>
    </style>
</resources>
