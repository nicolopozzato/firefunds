# Settings for compose.yml. Fill in the three secrets before the first start,
# each with its own value from: openssl rand -hex 32
POSTGRES_PASSWORD=
APP_SECRET=
JWT_PASSPHRASE=

# Host name the app is reached at (no scheme, no port), e.g. for the Traefik
# example in the README.
DOMAIN=localhost
# The app listens on 127.0.0.1:PORT; put a reverse proxy in front for HTTPS.
PORT=8080
# Proxies whose X-Forwarded-For is believed (login throttling counts by the
# client's address). Private networks by default; narrow it to your proxy's
# address if you can.
#TRUSTED_PROXIES=PRIVATE_SUBNETS
# Scheduled jobs and the price calendar follow this timezone.
TIMEZONE=Europe/Rome

# Image version: latest follows the newest release; pin one with e.g. 1.2.0
# (or 1.2 for its latest patch).
FIREFUNDS_TAG=latest
